# ==============================================================================
# PromiseCheck - Environment Configuration Blueprint
# ==============================================================================

# Application Environment
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DEFAULT_TIMEZONE=UTC

# Identity & Authentication (OIDC / OAuth)
SESSION_SIGNING_KEY=generate-a-secure-random-32-byte-hex-key
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret

# Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/promisecheck
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 compatible)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=promisecheck-artifacts
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Encryption (KMS or secret envelope)
KMS_KEY_ID=local-development-kms-key

# AI & Language Models
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-latest
LLM_API_KEY=your-llm-api-key
EMBEDDING_MODEL=text-embedding-3-small
AI_RUN_COST_LIMIT=1.00

# Meeting & Audio Capture
RECALL_API_KEY=your-recall-api-key
RECALL_REGION=us-west-2
SPEECH_PROVIDER=deepgram
SPEECH_API_KEY=your-deepgram-api-key

# Engineering Trackers
JIRA_CLIENT_ID=your-jira-client-id
JIRA_CLIENT_SECRET=your-jira-client-secret
LINEAR_CLIENT_ID=your-linear-client-id
LINEAR_CLIENT_SECRET=your-linear-client-secret

# Internal Alerts & Communications
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
EMAIL_PROVIDER_API_KEY=your-email-api-key

# Model Context Protocol (MCP)
MCP_PUBLIC_URL=http://localhost:8000/mcp
MCP_AUTH_ISSUER=http://localhost:8000
MCP_AUDIENCE=promisecheck-mcp
