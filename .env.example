# ==============================================================================
# PromiseCheck - Environment Configuration Blueprint
# ==============================================================================
# Copy to .env and fill in real values. Never commit .env.
# Production deployments must set every value marked REQUIRED.

# Application Environment
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DEFAULT_TIMEZONE=UTC
LOG_LEVEL=INFO

# Identity & Authentication (JWT + Google OIDC)
# REQUIRED in production: random string >= 32 chars.
SESSION_SIGNING_KEY=generate-a-secure-random-32-byte-hex-key
SECRET_KEY=generate-a-secure-random-secret-key
JWT_SECRET_KEY=generate-a-secure-random-jwt-secret-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Secret Encryption at Rest
# REQUIRED in production: dedicated random string >= 32 chars.
# Encrypts tenant OAuth tokens, API keys and webhook secrets at rest.
# This is intentionally separate from SESSION_SIGNING_KEY / JWT_SECRET_KEY.
SECRET_ENCRYPTION_KEY=generate-a-dedicated-random-encryption-key

# Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/promisecheck
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/promisecheck
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 compatible)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=promisecheck-artifacts
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# AI & Language Models
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your-groq-api-key
LLM_API_KEY=your-llm-api-key
EMBEDDING_MODEL=text-embedding-3-small
AI_RUN_COST_LIMIT=1.00

# Meeting & Audio Capture
SPEECH_PROVIDER=deepgram
SPEECH_API_KEY=your-deepgram-api-key
# Optional: pre-provisioned Google access token for local connector testing.
GOOGLE_ACCESS_TOKEN=
GOOGLE_AUTHORIZED_EMAIL=
GMAIL_ACCESS_TOKEN=

# Engineering Trackers
JIRA_CLIENT_ID=your-jira-client-id
JIRA_CLIENT_SECRET=your-jira-client-secret
JIRA_DOMAIN=your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
LINEAR_CLIENT_ID=your-linear-client-id
LINEAR_CLIENT_SECRET=your-linear-client-secret
LINEAR_API_KEY=your-linear-api-key

# Internal Alerts & Communications
SLACK_APP_ID=your-slack-app-id
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_VERIFICATION_TOKEN=your-slack-verification-token
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_WEBHOOK_URL=
SLACK_ALERT_CHANNEL=#all-aishield

# Email delivery (Resend). EMAIL_API_KEY is accepted as a legacy alias.
RESEND_API_KEY=your-resend-api-key
EMAIL_API_KEY=
EMAIL_FROM=notifications@promisecheck.com

# Model Context Protocol (MCP)
MCP_PUBLIC_URL=http://localhost:8000/mcp
MCP_AUTH_ISSUER=http://localhost:8000
MCP_AUDIENCE=promisecheck-mcp
# Optional outbound MCP server endpoint.
EXTERNAL_MCP_URL=
